case "$reason" in
    BOUND6|RENEW6|REBIND6|REBOOT6)
        case "$interface" in
            ppp*)
                systemctl --no-block restart \
                    boxproxy-client-routing-refresh.service \
                    >/dev/null 2>&1 || true
                ;;
        esac
        ;;
esac


# BOXPROXY_RDNSS_STATE
case "$reason" in
    ROUTERADVERT)
        case "$interface" in
            ppp*)
                [ -n "${new_rdnss:-}" ] || return 0

                for CONF in /etc/boxproxy/instances/*.conf; do
                    [ -f "$CONF" ] || continue

                    unset PPP_IF IP_MODE
                    . "$CONF"

                    [ "${PPP_IF:-}" = "$interface" ] || continue
                    [ "${IP_MODE:-ipv4}" = "ipv6" ] || continue

                    ID="$(basename "$CONF" .conf)"
                    set -- $new_rdnss
                    DNS1="${1:-}"
                    DNS2="${2:-}"

                    [ -n "$DNS1" ] || return 0

                    mkdir -p /etc/boxproxy/dns
                    chmod 700 /etc/boxproxy/dns

                    DNS_STATE="/etc/boxproxy/dns/${ID}.servers"
                    {
                        printf 'DNS1="%s"
' "$DNS1"
                        printf 'DNS2="%s"
' "$DNS2"
                    } > "$DNS_STATE"
                    chmod 600 "$DNS_STATE"

                    /usr/bin/resolvectl dns "$interface"                         ${DNS1:+$DNS1} ${DNS2:+$DNS2}                         >/dev/null 2>&1 || true
                    /usr/bin/resolvectl domain "$interface" '~.'                         >/dev/null 2>&1 || true

                    systemctl reset-failed                         "boxproxy-dns@${ID}.service"                         >/dev/null 2>&1 || true
                    systemctl --no-block restart                         "boxproxy-dns@${ID}.service"                         >/dev/null 2>&1 || true

                    break
                done
                ;;
        esac
        ;;
esac
