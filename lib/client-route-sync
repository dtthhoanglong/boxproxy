#!/bin/bash
set -e

CONF_DIR="/etc/boxproxy/client-routes"

LOCK_FILE="/run/boxproxy-client-route-sync.lock"

exec 9>"$LOCK_FILE"
flock -x 9

mkdir -p "$CONF_DIR"

# Xóa các rule do client routing manager tạo trước đó
# Chỉ xóa đúng dải priority 2000-2999, không đụng source-rule PPPoE 100x.
for PREF in $(ip rule show | awk -F: '$1 >= 2000 && $1 < 3000 {gsub(/ /,"",$1); print $1}'); do
    ip rule del pref "$PREF" 2>/dev/null || true
done

# Xóa IPv6 fwmark rules do client routing manager tạo.
for PREF in $(ip -6 rule show | awk -F: '$1 >= 2000 && $1 < 3000 {gsub(/ /,"",$1); print $1}'); do
    ip -6 rule del pref "$PREF" 2>/dev/null || true
done

# Xóa các iptables rule cũ có comment BOXPROXY-CLIENT
iptables -t mangle -S PREROUTING \
    | grep 'BOXPROXY-CLIENT' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        iptables -t mangle $RULE 2>/dev/null || true
    done

iptables -t nat -S POSTROUTING \
    | grep 'BOXPROXY-CLIENT' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        iptables -t nat $RULE 2>/dev/null || true
    done

iptables -S FORWARD \
    | grep 'BOXPROXY-CLIENT' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        iptables $RULE 2>/dev/null || true
    done

# Xóa fail-close rule cũ trước khi dựng lại routing.
iptables -S FORWARD \
    | grep 'BOXPROXY-FAILCLOSE' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        iptables $RULE 2>/dev/null || true
    done

# Xóa các DNS redirect rule cũ do BoxProxy tạo.
iptables -t nat -S PREROUTING \
    | grep 'BOXPROXY-DNS' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        iptables -t nat $RULE 2>/dev/null || true
    done

# PPPoE MTU 1492: clamp TCP MSS cho traffic LAN -> PPPoE.
# Xóa rule cũ trước để client-route-sync chạy nhiều lần không tạo duplicate.
iptables -t mangle -S FORWARD \
| grep 'BOXPROXY-MSS' \
| sed 's/^-A /-D /' \
| while read -r RULE; do
    iptables -t mangle $RULE 2>/dev/null || true
done

LAN_IF="$(ip -o -4 addr show | awk '$4 ~ /^10\.10\.10\.1\// {print $2; exit}')"

if [ -n "$LAN_IF" ]; then
    iptables -t mangle -A FORWARD \
        -i "$LAN_IF" -o ppp+ \
        -p tcp --tcp-flags SYN,RST SYN \
        -m comment --comment BOXPROXY-MSS \
        -j TCPMSS --set-mss 1452
fi

# Xóa các IPv6 mangle rule cũ của client routing.
ip6tables -t mangle -S PREROUTING \
    | grep 'BOXPROXY-CLIENT' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        ip6tables -t mangle $RULE 2>/dev/null || true
    done

# Xóa IPv6 NETMAP/NAT rules cũ của client routing.
ip6tables -t nat -S POSTROUTING \
    | grep 'BOXPROXY-CLIENT' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        ip6tables -t nat $RULE 2>/dev/null || true
    done

# Xóa IPv6 FORWARD rules cũ.
ip6tables -S FORWARD \
    | grep 'BOXPROXY-CLIENT' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        ip6tables $RULE 2>/dev/null || true
    done

# Xóa IPv6 fail-close cũ.
ip6tables -S FORWARD \
    | grep 'BOXPROXY-FAILCLOSE' \
    | sed 's/^-A /-D /' \
    | while read -r RULE; do
        ip6tables $RULE 2>/dev/null || true
    done

# Apply lại toàn bộ mapping đang enable
for CONF in "$CONF_DIR"/*.conf; do
    [ -f "$CONF" ] || continue

    unset ENABLED
    . "$CONF"

    [ "${ENABLED:-yes}" = "yes" ] || continue

    /usr/local/lib/boxproxy/client-route-up "$CONF"
done

# Fail-close LAN:
# chỉ những client đã có BOXPROXY-CLIENT ACCEPT rule ở phía trên
# mới được forward ra ngoài. Client chưa map sẽ dừng tại đây.
if [ -n "$LAN_IF" ]; then
    iptables -A FORWARD \
        -i "$LAN_IF" \
        -m comment --comment "BOXPROXY-FAILCLOSE" \
        -j DROP
fi

if [ -n "$LAN_IF" ]; then
    ip6tables -A FORWARD \
        -i "$LAN_IF" \
        -m comment --comment "BOXPROXY-FAILCLOSE" \
        -j DROP
fi

echo "Client routes synchronized"
