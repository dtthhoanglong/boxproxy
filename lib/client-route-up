#!/bin/bash
set -e

CONF="$1"

if [ -z "$CONF" ] || [ ! -f "$CONF" ]; then
    echo "Usage: client-route-up <config-file>"
    exit 1
fi

. "$CONF"

CLIENT_MAC="$MAC"

if [ "${ENABLED:-yes}" != "yes" ]; then
    exit 0
fi

INSTANCE_CONF="/etc/boxproxy/instances/${INSTANCE_ID}.conf"

if [ ! -f "$INSTANCE_CONF" ]; then
    echo "Proxy instance $INSTANCE_ID does not exist"
    exit 1
fi

. "$INSTANCE_CONF"

. /etc/boxproxy/settings.conf

eval "$(/usr/local/lib/boxproxy/instance-egress "$INSTANCE_ID")"

if [ -z "${EGRESS_IF:-}" ]; then
    echo "No egress interface for proxy $INSTANCE_ID"
    exit 1
fi

TABLE=$((100 + INSTANCE_ID))
MARK=$((10000 + INSTANCE_ID))
RULE_PREF=$((2000 + INSTANCE_ID))
DNS_PORT=$((5300 + INSTANCE_ID))

# MARK theo MAC nguồn trên LAN
iptables -t mangle -C PREROUTING \
    -i "$LAN_IF" \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j MARK --set-mark "$MARK" \
    2>/dev/null || \
iptables -t mangle -A PREROUTING \
    -i "$LAN_IF" \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j MARK --set-mark "$MARK"

# DNS của client luôn đi vào DNS instance tương ứng.
iptables -t nat -C PREROUTING \
    -i "$LAN_IF" \
    -p udp \
    --dport 53 \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-DNS" \
    -j DNAT --to-destination "10.10.10.1:${DNS_PORT}" \
    2>/dev/null || \
iptables -t nat -A PREROUTING \
    -i "$LAN_IF" \
    -p udp \
    --dport 53 \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-DNS" \
    -j DNAT --to-destination "10.10.10.1:${DNS_PORT}"

iptables -t nat -C PREROUTING \
    -i "$LAN_IF" \
    -p tcp \
    --dport 53 \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-DNS" \
    -j DNAT --to-destination "10.10.10.1:${DNS_PORT}" \
    2>/dev/null || \
iptables -t nat -A PREROUTING \
    -i "$LAN_IF" \
    -p tcp \
    --dport 53 \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-DNS" \
    -j DNAT --to-destination "10.10.10.1:${DNS_PORT}"

# fwmark -> routing table của proxy instance
ip rule del pref "$RULE_PREF" 2>/dev/null || true
ip rule add fwmark "$MARK" table "$TABLE" priority "$RULE_PREF"

# =========================
# IPv6 MAC routing
# =========================

# MARK IPv6 theo MAC nguồn trên LAN.
ip6tables -t mangle -C PREROUTING \
    -i "$LAN_IF" \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j MARK --set-mark "$MARK" \
    2>/dev/null || \
ip6tables -t mangle -A PREROUTING \
    -i "$LAN_IF" \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j MARK --set-mark "$MARK"

# fwmark IPv6 -> cùng routing table của proxy instance.
ip -6 rule del pref "$RULE_PREF" 2>/dev/null || true
ip -6 rule add \
    fwmark "$MARK" \
    table "$TABLE" \
    priority "$RULE_PREF"

# Prefix ULA cố định của LAN.
LAN_IPV6_PREFIX="fd00:10:10:10::/64"

# Lấy delegated prefix hiện tại của đúng proxy instance.
PD_PREFIX=$(
    /usr/local/lib/boxproxy/ipv6-pd-prefix "$INSTANCE_ID"
) || {
    echo "No IPv6 PD for proxy $INSTANCE_ID"
    exit 1
}

# Dịch 1:1 ULA -> delegated prefix của đúng PPPoE.
# Conntrack/NAT sẽ tự dịch ngược return traffic.
ip6tables -t nat -C POSTROUTING \
    -s "$LAN_IPV6_PREFIX" \
    -o "$EGRESS_IF" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j NETMAP --to "$PD_PREFIX" \
    2>/dev/null || \
ip6tables -t nat -A POSTROUTING \
    -s "$LAN_IPV6_PREFIX" \
    -o "$EGRESS_IF" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j NETMAP --to "$PD_PREFIX"

# IPv6 LAN -> đúng egress.
# Client dùng ULA; NETMAP phía trên đổi sang PD của instance.
ip6tables -C FORWARD \
    -i "$LAN_IF" \
    -o "$EGRESS_IF" \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j ACCEPT \
    2>/dev/null || \
ip6tables -A FORWARD \
    -i "$LAN_IF" \
    -o "$EGRESS_IF" \
    -m mac --mac-source "$CLIENT_MAC" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j ACCEPT

# Return traffic IPv6 từ egress -> LAN.
ip6tables -C FORWARD \
    -i "$EGRESS_IF" \
    -o "$LAN_IF" \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j ACCEPT \
    2>/dev/null || \
ip6tables -A FORWARD \
    -i "$EGRESS_IF" \
    -o "$LAN_IF" \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j ACCEPT

# NAT client qua đúng egress interface
iptables -t nat -C POSTROUTING \
    -s "${CLIENT_IP}/32" \
    -o "$EGRESS_IF" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j MASQUERADE \
    2>/dev/null || \
iptables -t nat -A POSTROUTING \
    -s "${CLIENT_IP}/32" \
    -o "$EGRESS_IF" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j MASQUERADE

# Forward LAN -> egress
iptables -C FORWARD \
    -i "$LAN_IF" \
    -o "$EGRESS_IF" \
    -s "${CLIENT_IP}/32" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j ACCEPT \
    2>/dev/null || \
iptables -A FORWARD \
    -i "$LAN_IF" \
    -o "$EGRESS_IF" \
    -s "${CLIENT_IP}/32" \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j ACCEPT

# Return traffic egress -> LAN
iptables -C FORWARD \
    -i "$EGRESS_IF" \
    -o "$LAN_IF" \
    -d "${CLIENT_IP}/32" \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j ACCEPT \
    2>/dev/null || \
iptables -A FORWARD \
    -i "$EGRESS_IF" \
    -o "$LAN_IF" \
    -d "${CLIENT_IP}/32" \
    -m conntrack --ctstate ESTABLISHED,RELATED \
    -m comment --comment "BOXPROXY-CLIENT" \
    -j ACCEPT

echo "Client route enabled:"
echo "MAC        : $CLIENT_MAC"
echo "Client IP  : $CLIENT_IP"
echo "Proxy ID   : $INSTANCE_ID"
echo "Egress     : $EGRESS_IF"
echo "Table      : $TABLE"
echo "Mark       : $MARK"
