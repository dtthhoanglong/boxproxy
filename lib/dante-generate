#!/bin/bash
set -e

ID="$1"
CONF="/etc/boxproxy/instances/${ID}.conf"
OUT="/etc/boxproxy/dante/${ID}.conf"

[ -f "$CONF" ] || exit 1
. "$CONF"

eval "$(/usr/local/lib/boxproxy/instance-egress "$ID")"

if [ -z "${EGRESS_IF:-}" ] || [ -z "${EGRESS_IP:-}" ]; then
    echo "No egress available for instance $ID"
    exit 1
fi

cat > "$OUT" <<EOF
logoutput: syslog

# Accept SOCKS5 from LAN and from the current egress IPv4.
internal: 10.10.10.1 port = ${SOCKS_PORT}
internal: ${EGRESS_IP} port = ${SOCKS_PORT}

external: ${EGRESS_IF}

clientmethod: none
socksmethod: username

user.privileged: root
user.notprivileged: nobody
user.libwrap: nobody

client pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: connect disconnect error
}

socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    command: connect udpassociate
    socksmethod: username
    log: connect disconnect error
}

socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    command: udpreply
    log: connect disconnect error
}
EOF

chmod 600 "$OUT"
