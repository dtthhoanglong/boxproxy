#!/bin/bash
set -e

ID="$1"
CONF="/etc/boxproxy/instances/${ID}.conf"
OUT="/etc/boxproxy/squid/${ID}.conf"

[ -f "$CONF" ] || exit 1
. "$CONF"

eval "$(/usr/local/lib/boxproxy/instance-egress "$ID")"

if [ -z "${EGRESS_IF:-}" ] || [ -z "${EGRESS_IP:-}" ]; then
    echo "No egress available for instance $ID"
    exit 1
fi

cat > "$OUT" <<EOF

http_port 10.10.10.1:${HTTP_PORT}
http_port ${EGRESS_IP}:${HTTP_PORT}
tcp_outgoing_address ${EGRESS_IP}

shutdown_lifetime 1 second

auth_param basic program /usr/lib/squid/basic_ncsa_auth /etc/squid/passwd
auth_param basic realm BoxProxy
auth_param basic credentialsttl 2 hours

acl authenticated proxy_auth REQUIRED

acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow authenticated
http_access deny all

cache deny all
forwarded_for delete

pid_filename /run/boxproxy-squid-${ID}.pid
access_log /var/log/squid/boxproxy-${ID}-access.log
cache_log /var/log/squid/boxproxy-${ID}-cache.log
EOF

chmod 600 "$OUT"
