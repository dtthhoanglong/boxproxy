#!/bin/bash
set -e

ID="$1"
CONF="/etc/boxproxy/instances/${ID}.conf"

[ -f "$CONF" ] || exit 1
. "$CONF"

for i in $(seq 1 30); do
    if /usr/local/lib/boxproxy/instance-egress "$ID" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

/usr/local/lib/boxproxy/instance-egress "$ID" >/dev/null 2>&1 || exit 1

/usr/local/lib/boxproxy/squid-generate "$ID"

exec /usr/sbin/squid -N -f "/etc/boxproxy/squid/${ID}.conf"
