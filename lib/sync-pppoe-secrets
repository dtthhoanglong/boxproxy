#!/bin/bash
set -e

TMP_PAP=$(mktemp)
TMP_CHAP=$(mktemp)

trap 'rm -f "$TMP_PAP" "$TMP_CHAP"' EXIT

# Giữ nguyên toàn bộ nội dung cũ, nhưng bỏ các entry PPPoE do BoxProxy quản lý
awk '
BEGIN { skip=0 }
{
    if ($0 ~ /^# BOXPROXY BEGIN$/) { skip=1; next }
    if ($0 ~ /^# BOXPROXY END$/)   { skip=0; next }
    if (!skip) print
}
' /etc/ppp/pap-secrets > "$TMP_PAP"

awk '
BEGIN { skip=0 }
{
    if ($0 ~ /^# BOXPROXY BEGIN$/) { skip=1; next }
    if ($0 ~ /^# BOXPROXY END$/)   { skip=0; next }
    if (!skip) print
}
' /etc/ppp/chap-secrets > "$TMP_CHAP"

{
    echo
    echo "# BOXPROXY BEGIN"

    for WAN_CONF in /etc/boxproxy/wans/*.conf; do
        [ -f "$WAN_CONF" ] || continue

        unset PPPOE_USER
        unset PPPOE_PASSWORD

        . "$WAN_CONF"

        [ -n "$PPPOE_USER" ] || continue
        [ -n "$PPPOE_PASSWORD" ] || continue

        printf '"%s"\t*\t"%s"\t*\n' \
            "$PPPOE_USER" \
            "$PPPOE_PASSWORD"
    done

    echo "# BOXPROXY END"
} >> "$TMP_PAP"

{
    echo
    echo "# BOXPROXY BEGIN"

    for WAN_CONF in /etc/boxproxy/wans/*.conf; do
        [ -f "$WAN_CONF" ] || continue

        unset PPPOE_USER
        unset PPPOE_PASSWORD

        . "$WAN_CONF"

        [ -n "$PPPOE_USER" ] || continue
        [ -n "$PPPOE_PASSWORD" ] || continue

        printf '"%s"\t*\t"%s"\t*\n' \
            "$PPPOE_USER" \
            "$PPPOE_PASSWORD"
    done

    echo "# BOXPROXY END"
} >> "$TMP_CHAP"

install -m 600 -o root -g root "$TMP_PAP" /etc/ppp/pap-secrets
install -m 600 -o root -g root "$TMP_CHAP" /etc/ppp/chap-secrets
