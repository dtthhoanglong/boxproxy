#!/bin/bash
set -e

. /etc/boxproxy/settings.conf

for i in $(seq 1 30); do
    if ip -4 -o addr show dev "$LAN_IF" 2>/dev/null \
        | grep -q "10\.10\.10\.1/24"; then
        exit 0
    fi

    sleep 1
done

echo "BoxProxy LAN interface $LAN_IF did not get 10.10.10.1/24 within 30 seconds"
exit 1
