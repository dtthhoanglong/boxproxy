#!/bin/bash
set -e

for WAN_CONF in /etc/boxproxy/wans/*.conf; do
    [ -f "$WAN_CONF" ] || continue

    unset WAN_ID WAN_TYPE
    . "$WAN_CONF"

    WAN_TYPE="${WAN_TYPE:-pppoe}"

    case "$WAN_TYPE" in
        dhcp|wifi)
            echo "Restoring $WAN_TYPE WAN $WAN_ID..."

            /usr/local/sbin/boxproxy \
                wan-start "$WAN_ID"
            ;;

        pppoe)
            # PPPoE vẫn được systemd template/service
            # khôi phục theo cơ chế hiện tại.
            ;;

        *)
            echo "Skipping unsupported WAN type: $WAN_TYPE"
            ;;
    esac
done

echo "BoxProxy WAN restore completed"
