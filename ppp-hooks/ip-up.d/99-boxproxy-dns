#!/bin/sh

IFACE="$1"

for CONF in /etc/boxproxy/instances/*.conf; do
    [ -f "$CONF" ] || continue

    unset WAN_ID PPP_IF
    . "$CONF"

    [ "$PPP_IF" = "$IFACE" ] || continue

    ID="$(basename "$CONF" .conf)"

    mkdir -p /etc/boxproxy/dns
    chmod 700 /etc/boxproxy/dns

    DNS_STATE="/etc/boxproxy/dns/${ID}.servers"

    {
        printf 'DNS1="%s"\n' "${DNS1:-}"
        printf 'DNS2="%s"\n' "${DNS2:-}"
    } > "$DNS_STATE"

    chmod 600 "$DNS_STATE"

    # Giữ systemd-resolved của host hoạt động như trước.
    if [ -n "${DNS1:-}" ]; then
        /usr/bin/resolvectl dns "$IFACE" \
            ${DNS1:+$DNS1} \
            ${DNS2:+$DNS2} 2>/dev/null || true

        /usr/bin/resolvectl domain "$IFACE" '~.' \
            2>/dev/null || true
    fi

    systemctl reset-failed \
        "boxproxy-dns@${ID}.service" \
        2>/dev/null || true

    systemctl restart \
        "boxproxy-dns@${ID}.service" \
        2>/dev/null || true

    exit 0
done

exit 0
